# To use your own domain name (with automatic HTTPS), first make
# sure your domain's A/AAAA DNS records are properly pointed to
# this machine's public IP, then replace "example.com" below with your
# domain name.

# Originally taken from Caddyfile_global in root of repo.

{
    # Set the ACME DNS challenge provider to use Cloudflare for all sites
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	servers {
		trusted_proxies cloudflare
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# https://caddyserver.com/docs/caddyfile/directives/log#wildcard-logs
# This works for multiple subdomains logging.
(subdomain-log) {
	log {
		hostnames {args[0]}
		output file /var/log/caddy/{args[0]}.log
		# roll_size 10MB # Create new file when size exceeds 10MB
		# roll_keep 5 # Keep at most 5 rolled files
	}
}

# Deny requests that are not proxied by Cloudflare.
# This will block anything not coming in from Cloudflare with a 403 by default.
# If you aren't using Cloudflare, this should be disabled.
:80, :443 {
	@notFromCF not remote_ip 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	@notHost not host git.example.com

	respond @notFromCF "Forbidden: connect via Cloudflare" 403
	respond @notHost "Forbidden host" 403

	# Normal site behavior for allowed hostnames:
	handle @notFromCF {
		# nothing
	}
}

example.com {

    # Set this path to your site's directory.
    root * /usr/share/caddy

    # Enable the static file server.
    file_server

    # Another common task is to set up a reverse proxy:
    # reverse_proxy localhost:8080

    # Or serve a PHP site through php-fpm:
    # php_fastcgi localhost:9000

    encode gzip

    tls {
        # No need to specify dns here, it's already set globally
    }
}

*.example.com example.com {
	@blocked {
		# Allow LAN for now, this can be set to your VPN IP.
		not remote_ip 192.168.1.1/32
	}

    # https://caddyserver.com/docs/caddyfile/directives/handle_errors
	# For the custom error pages.
	handle_errors {
		@404 {
			expression int({http.error.status_code}) == 404
		}

		# https://stackharbor.com/en/knowledge-base/caddy-error-handling/
		handle @404 {
            # For generic errors
			# rewrite * /error.html
			rewrite * /404.html
			file_server {
				root /opt/caddy/pages/error
			}
		}

		respond "{err.status_code} {err.status_text}"
	}

    # This works for a basic rate limiter.
	# I can easily use this to stop a lot of bot traffic.
	# TODO Figure out how to set this for only specific subdomains.
	rate_limit {
		distributed
		# zone static_example {
		# match {
		# method GET
		# }
		# key    static
		# events 100
		# window 1m
		# }
		zone dynamic_example {
			key {http.request.header.CF-Connecting-IP}
			
            # Set to 10 requests per second.
            events 10
            window 1s
			# events 5
#			window 2s
			# IPv6 prefix rate limiting
			# https://github.com/mholt/caddy-ratelimit#network-prefix-rate-limiting
			ipv6_prefix 64
		}
		log_key
	}

    #-------------------
    # Downloads subdomain
    #-------------------
    import subdomain-log download.example.com
	@download host download.example.com
    handle @download {
        # Same path as set in docker-compose.yml, otherwise it won't work.
        root * /mnt/website_files/download

		# https://caddyserver.com/docs/caddyfile/directives/file_server
		file_server
        # This below can be enabled for an open directory pretty much.
        # file_server browse {
			# hide "/opt/downloads/test.txt"
			# I can hide files with this!
			# This is relative to the root defined above.
			# They can still be directly viewed, but don't show up in the file list which could be useful for something.
			# hide "/test.txt"
			# hide .git .env
		# }
		encode
    }

}
